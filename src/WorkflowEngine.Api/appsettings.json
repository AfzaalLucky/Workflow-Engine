{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WorkflowEngineDb": "Server=.;Database=WorkflowEngineDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5183" ]
  },
  "WorkflowEvents": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 10,
    "RetryDelaySeconds": 15,
    "Webhooks": []
  },
  "Jwt": {
    "Issuer": "WorkflowEngine",
    "Audience": "WorkflowEngineClients",
    "SigningKey": "dev-only-signing-key-replace-with-a-real-secret-before-any-shared-deployment-32chars+",
    "ExpiryMinutes": 480
  }
}
